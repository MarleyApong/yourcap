{
  "expo": {
    "name": "YourCap",
    "slug": "yourcap-slug",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/logo.png",
    "scheme": "yourcap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Yourcap utilise Face ID pour vous authentifier de manière sécurisée.",
        "NSLocalAuthenticationUsageDescription": "Yourcap utilise la biométrie pour sécuriser l'accès à vos données.",
        "NSDocumentsFolderUsageDescription": "Yourcap accède à vos documents pour l'import/export de données.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/logo.png",
        "backgroundColor": "#562d8f"
      },
      "package": "com.marleyapong.yourcap",
      "versionCode": 2,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://yourcap-slug.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/logo-white.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#562d8f"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/logo-white.png",
          "color": "#562d8f",
          "defaultChannel": "default",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new notification(s)"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Yourcap utilise Face ID pour vous authentifier de manière sécurisée."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Yourcap utilise Face ID pour sécuriser vos données stockées."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "db21fc39-6fb2-4b12-b025-f82890ba36ce"
      }
    }
  }
}
